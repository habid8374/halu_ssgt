# Django
DJANGO_SECRET_KEY=cambia-esto-en-produccion
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web

# Cifrado de campos clínicos (regla 10). En producción: clave dedicada, rotada.
CRYPTOGRAPHY_KEY=cambia-esta-clave-de-cifrado-clinico

# PostgreSQL
POSTGRES_DB=halu_salud
POSTGRES_USER=halu
POSTGRES_PASSWORD=halu
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis / Channels / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# CORS (frontend Next.js)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Almacenamiento de objetos: filesystem (dev) | s3 (MinIO/S3)
STORAGE_BACKEND=filesystem
